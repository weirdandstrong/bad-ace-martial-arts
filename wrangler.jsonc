{
  // Cloudflare config — lets Cloudflare auto-configure the deploy when you
  // connect this repo (Workers & Pages → Create → import repository).
  // No build step: this is a static site served from /site.
  "name": "badace-fm",
  "compatibility_date": "2026-08-06",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  }
}
